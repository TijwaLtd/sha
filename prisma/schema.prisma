generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  HOSPITAL_USER
  SHA_OFFICER
  ADMIN
}

enum HospitalStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  UNKNOWN
}

enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  PENDING
  REJECTED
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  VALIDATING
  ANALYZING
  ASSESSED
  CLEARED
  FLAGGED
  UNDER_REVIEW
  RESOLVED
}

enum ClaimSource {
  HOSPITAL_PORTAL
  API
  IMPORT
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingSource {
  RULE
  AI
  SYSTEM
  REVIEW
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ReviewOutcome {
  CLEARED
  CONFIRMED_ANOMALY
  REJECTED_CLAIM
  ESCALATED
  NEEDS_MORE_INFORMATION
}

enum AiAnalysisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AlertType {
  HIGH_RISK_CLAIM
  FACILITY_VERIFICATION
  SERVICE_MISMATCH
  UNUSUAL_BILLING
  DUPLICATE_CLAIM
  AI_REVIEW_REQUIRED
}

// ─── Identity ────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(HOSPITAL_USER)
  hospitalId   String?
  hospital     Hospital? @relation(fields: [hospitalId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reviews      Review[]
  auditLogs    AuditLog[]
  claimActions Claim[]    @relation("ClaimSubmitter")
  resolvedAlerts Alert[]  @relation("AlertResolver")

  @@index([role])
  @@index([hospitalId])
}

// ─── Facilities ──────────────────────────────────────────

model Hospital {
  id                 String             @id @default(cuid())
  facilityIdentifier String             @unique
  name               String
  type               String?
  status             HospitalStatus     @default(UNKNOWN)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  location           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users    User[]
  services HospitalService[]
  claims   Claim[]
  alerts   Alert[]

  @@index([status])
  @@index([verificationStatus])
}

model HospitalService {
  id         String   @id @default(cuid())
  hospitalId String
  serviceId  String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([hospitalId, serviceId])
  @@index([hospitalId])
  @@index([serviceId])
}

model Service {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  category    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospitalServices HospitalService[]
  claimItems       ClaimItem[]

  @@index([category])
}

// ─── Claims ──────────────────────────────────────────────

model Claim {
  id               String      @id @default(cuid())
  reference        String      @unique
  hospitalId       String
  submittedById    String?
  patientReference String
  diagnosis        String?
  status           ClaimStatus @default(DRAFT)
  source           ClaimSource @default(HOSPITAL_PORTAL)
  totalAmountCents Int         @default(0)
  submittedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  hospital        Hospital              @relation(fields: [hospitalId], references: [id])
  submitter       User?                 @relation("ClaimSubmitter", fields: [submittedById], references: [id])
  items           ClaimItem[]
  ruleEvaluations ClaimRuleEvaluation[]
  findings        Finding[]
  aiAnalyses      AiAnalysis[]
  aiFindings      AiFinding[]
  riskScore       RiskScore?
  reviews         Review[]
  alerts          Alert[]

  @@index([hospitalId])
  @@index([status])
  @@index([submittedAt])
  @@index([reference])
  @@index([source])
}

model ClaimItem {
  id               String   @id @default(cuid())
  claimId          String
  serviceId        String
  description      String?
  quantity         Int      @default(1)
  unitAmountCents  Int
  totalAmountCents Int
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  claim      Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  service    Service     @relation(fields: [serviceId], references: [id])
  findings   Finding[]
  aiFindings AiFinding[]

  @@index([claimId])
  @@index([serviceId])
}

// ─── Compliance Rules ────────────────────────────────────

model ComplianceRule {
  id                String          @id @default(cuid())
  code              String          @unique
  name              String
  description       String?
  category          String?
  severity          FindingSeverity @default(MEDIUM)
  scoreContribution Int             @default(0)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  evaluations ClaimRuleEvaluation[]
  findings    Finding[]

  @@index([code])
  @@index([category])
  @@index([active])
}

model ClaimRuleEvaluation {
  id                String   @id @default(cuid())
  claimId           String
  complianceRuleId  String
  triggered         Boolean  @default(false)
  scoreContribution Int      @default(0)
  explanation       String?
  evaluatedAt       DateTime @default(now())

  claim          Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  complianceRule ComplianceRule @relation(fields: [complianceRuleId], references: [id])

  @@unique([claimId, complianceRuleId])
  @@index([claimId])
  @@index([complianceRuleId])
  @@index([triggered])
}

// ─── Findings ────────────────────────────────────────────

model Finding {
  id                String          @id @default(cuid())
  claimId           String
  claimItemId       String?
  complianceRuleId  String?
  aiAnalysisId      String?
  type              String
  severity          FindingSeverity
  source            FindingSource
  title             String
  explanation       String?
  evidence          Json?
  scoreContribution Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  claim          Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimItem      ClaimItem?      @relation(fields: [claimItemId], references: [id])
  complianceRule ComplianceRule? @relation(fields: [complianceRuleId], references: [id])
  aiAnalysis     AiAnalysis?     @relation(fields: [aiAnalysisId], references: [id])

  @@index([claimId])
  @@index([claimItemId])
  @@index([source])
  @@index([severity])
}

// ─── AI Analysis ─────────────────────────────────────────

model AiAnalysis {
  id                 String           @id @default(cuid())
  claimId            String
  provider           String
  model              String
  status             AiAnalysisStatus @default(PENDING)
  promptVersion      String?
  structuredResponse Json?
  confidence         Float?
  rawOutput          String?
  errorMessage       String?
  startedAt          DateTime         @default(now())
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  claim        Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  findings     AiFinding[]
  ruleFindings Finding[]

  @@index([claimId])
  @@index([status])
  @@index([provider])
}

model AiFinding {
  id           String          @id @default(cuid())
  aiAnalysisId String
  claimId      String
  claimItemId  String?
  type         String
  severity     FindingSeverity
  confidence   Float?
  explanation  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  aiAnalysis AiAnalysis @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)
  claim      Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimItem  ClaimItem? @relation(fields: [claimItemId], references: [id])

  @@index([aiAnalysisId])
  @@index([claimId])
  @@index([severity])
}

// ─── Risk ────────────────────────────────────────────────

model RiskScore {
  id           String    @id @default(cuid())
  claimId      String    @unique
  score        Int
  level        RiskLevel
  calculatedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  claim        Claim             @relation(fields: [claimId], references: [id], onDelete: Cascade)
  contributors RiskContributor[]
  alerts       Alert[]

  @@index([level])
  @@index([score])
}

model RiskContributor {
  id          String   @id @default(cuid())
  riskScoreId String
  type        String
  description String?
  scoreImpact Int
  metadata    Json?
  createdAt   DateTime @default(now())

  riskScore RiskScore @relation(fields: [riskScoreId], references: [id], onDelete: Cascade)

  @@index([riskScoreId])
}

// ─── Investigation ───────────────────────────────────────

model Review {
  id          String         @id @default(cuid())
  claimId     String
  reviewerId  String
  status      ReviewStatus   @default(PENDING)
  outcome     ReviewOutcome?
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  claim    Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  reviewer User           @relation(fields: [reviewerId], references: [id])
  actions  ReviewAction[]

  @@index([claimId])
  @@index([reviewerId])
  @@index([status])
}

model ReviewAction {
  id          String   @id @default(cuid())
  reviewId    String
  action      String
  details     Json?
  performedAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// ─── Audit ───────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ─── Alerts ─────────────────────────────────────────────

model Alert {
  id          String      @id @default(cuid())
  type        AlertType
  severity    FindingSeverity
  status      AlertStatus @default(OPEN)
  title       String
  description String?
  claimId     String?
  hospitalId  String?
  riskScoreId String?
  source      FindingSource
  metadata    Json?
  resolvedAt  DateTime?
  resolvedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  claim     Claim?     @relation(fields: [claimId], references: [id])
  hospital  Hospital?  @relation(fields: [hospitalId], references: [id])
  riskScore RiskScore? @relation(fields: [riskScoreId], references: [id])
  resolvedBy User?     @relation("AlertResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([claimId])
  @@index([hospitalId])
  @@index([createdAt])
}
